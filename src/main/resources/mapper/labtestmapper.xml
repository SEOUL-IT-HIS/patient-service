<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.co.seoulit.his.patientservice.patient.mapper.PatientProcedureMapper">
    <select id="countPatients" statementType="CALLABLE" parameterType="map" useCache="false">
        { CALL PROC_PATIENT_COUNT(
            #{statusCd, mode=IN, jdbcType=VARCHAR},
            #{count, mode=OUT, jdbcType=NUMERIC, javaType=java.math.BigDecimal}
        ) }
    </select>
</mapper>
